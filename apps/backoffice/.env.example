# Copier en .env.local et renseigner les valeurs du projet Supabase
# (local : `npx supabase status` depuis supabase/ ; distant : Settings > API).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cle de service : donne un acces complet a la base, en contournant les
# politiques RLS. Ne jamais l'exposer au navigateur (pas de prefixe
# NEXT_PUBLIC_) ni la committer avec une vraie valeur.
SUPABASE_SERVICE_ROLE_KEY=
